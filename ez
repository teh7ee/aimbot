local function updateESP()
    if not running or _G.ESPEnabled == false then
        for plr in pairs(espPool) do destroyEsp(plr) end
        return
    end
    if not ESPFolder or not ESPFolder.Parent then
        ESPFolder = Instance.new("Folder")
        ESPFolder.Name = "BF_SilentAim_ESP"
        pcall(function() ESPFolder.Parent = CoreGui end)
        if not ESPFolder.Parent then
            local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 3)
            ESPFolder.Parent = pg
        end
    end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local maxDist = tonumber(_G.ESP_MaxDist) or 0
    if maxDist <= 0 then maxDist = 1e12 end -- 全图
    local maxPlayers = math.clamp(tonumber(_G.ESP_MaxPlayers) or 100, 1, 250)
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
                if d <= maxDist then list[#list + 1] = { plr = plr, hrp = hrp, hum = hum, d = d } end
            end
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    local keep = {}
    for i = 1, math.min(#list, maxPlayers) do
        local e = list[i]
        keep[e.plr] = true
        local pack = ensureEsp(e.plr, e.hrp)
        local fruit, race, ken = getPlayerDataLite(e.plr)
        local friendly = false
        pcall(function() friendly = isFriendly(e.plr) end)
        pack.label.RichText = true
        if friendly then
            local fontSize = math.clamp(tonumber(_G.ESP_FontSize) or 14, 10, 36)
            local sub = {}
            if _G.ESP_Level ~= false then
                local lv = getLevel(e.plr)
                if lv then sub[#sub + 1] = "Lv" .. tostring(math.floor(lv)) end
            end
            if _G.ESP_Bounty ~= false then
                local bv, bk = getBountyOrHonor(e.plr)
                if bv then sub[#sub + 1] = (bk or "Bounty") .. ":" .. formatBounty(bv) end
            end
            if _G.ESP_HP ~= false then sub[#sub + 1] = string.format("HP %.0f/%.0f", e.hum.Health, e.hum.MaxHealth) end
            if _G.ESP_Fruit ~= false then sub[#sub + 1] = "果实:" .. fruit end
            if _G.ESP_Race ~= false then sub[#sub + 1] = "种族:" .. race end
            if _G.ESP_Ken ~= false then sub[#sub + 1] = "见闻:" .. ken end
            sub[#sub + 1] = string.format("%.0fm", e.d)
            pack.label.Text = string.format(
                '<font size="30"><b><font color="#55FF88">【队友】</font></b></font>\n<font size="16"><font color="#BBFFCC">%s</font></font>\n<font size="13"><font color="#CCFFDD">%s</font></font>',
                e.plr.Name,
                table.concat(sub, "  ")
            )
            pack.label.TextColor3 = Color3.fromRGB(100, 255, 150)
            pack.label.TextSize = fontSize
        else
            local fontSize = math.clamp(tonumber(_G.ESP_FontSize) or 14, 10, 36)
            local lines = { e.plr.Name }
            if _G.ESP_Level ~= false then
                local lv = getLevel(e.plr)
                if lv then lines[#lines + 1] = "等级: " .. tostring(math.floor(lv)) end
            end
            if _G.ESP_Bounty ~= false then
                local bv, bk = getBountyOrHonor(e.plr)
                if bv then lines[#lines + 1] = (bk or "Bounty") .. ": " .. formatBounty(bv) end
            end
            if _G.ESP_HP ~= false then lines[#lines + 1] = string.format("HP %.0f/%.0f", e.hum.Health, e.hum.MaxHealth) end
            if _G.ESP_Fruit ~= false then lines[#lines + 1] = "果实: " .. fruit end
            if _G.ESP_Race ~= false then lines[#lines + 1] = "种族: " .. race end
            if _G.ESP_V3CD ~= false then lines[#lines + 1] = getRaceV3CD(e.plr) end
            if _G.ESP_Ken ~= false then lines[#lines + 1] = "见闻: " .. ken end
            lines[#lines + 1] = string.format("%.0fm", e.d)
            pack.label.Text = table.concat(lines, "\n")
            pack.label.TextSize = fontSize
            pack.label.TextColor3 = (currentTargetPlr == e.plr) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 230, 255)
        end
    end
    for plr in pairs(espPool) do
        if not keep[plr] then destroyEsp(plr) end
    end
end

