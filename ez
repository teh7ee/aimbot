local function GetFOVOrigin()
    -- 仅影响“FOV 圆心位置”；ShowFOV 只控制画不画，不决定能不能锁
    local cam = Workspace.CurrentCamera
    local mode = tostring(_G.FOVMode or "跟随鼠标")
    if mode == "屏幕中心" or mode == "Screen Center" or mode == "center" then
        if cam then
            local v = cam.ViewportSize
            return Vector2.new(v.X / 2, v.Y / 2)
        end
    end
    local p = UIS:GetMouseLocation()
    if p.X <= 0 or p.Y <= 0 then
        if cam then
            local v = cam.ViewportSize
            return Vector2.new(v.X / 2, v.Y / 2)
        end
    end
    return p
end

GetTarget = function(opts)
    opts = opts or {}
    local maxDist = tonumber(_G.MaxAimDist) or 800
    -- UseFOV = 是否启用 FOV 范围限制（与 ShowFOV 画圈无关）
    local useFOV = _G.UseFOV ~= false
    local fov = tonumber(_G.AimFOV) or 220
    local cam = Workspace.CurrentCamera
    local fovOrigin = GetFOVOrigin() -- 跟随鼠标 或 屏幕中心
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position
    local now = tick()
    -- 瞬步 R：无视鼠标/FOV/屏幕，强制锁最近可打敌人
    local soruMode = opts.soru == true or ((_G.SoruAim == true) and (LastSkillPressed == "R"))
    if soruMode then
        -- 参考脚本：最近敌人玩家、最大 500、无视 FOV/屏幕
        maxDist = 500
    end

    local angleMode = tostring(_G.AimAngleMode or "360")
    local function accept(plr, part)
        if not plr or plr == LocalPlayer then return false end
        if isFriendly(plr) then return false end
        -- PvP 关闭：硬拦，不再用「交战例外」放行（交战表容易误标 → 锁到关PvP的人）
        if _G.ExcludePVP ~= false and IsPvpDisabled(plr) then
            return false
        end
        -- 安全区：默认不锁；仅短距 + 明确交战才例外
        if _G.SafeZoneCheck ~= false and IsInSafeZone(plr) then
            local combatOk = IsInCombatWithMe(plr)
            if not combatOk then
                return false
            end
            -- 交战例外也绝不再锁「关了PvP」的人
            if IsPvpDisabled(plr) then
                return false
            end
            if myPos and (part.Position - myPos).Magnitude > 120 then
                return false
            end
        end
        if myPos and (part.Position - myPos).Magnitude > maxDist then return false end
        if soruMode then
            -- 瞬步也不锁关PvP
            if _G.ExcludePVP ~= false and IsPvpDisabled(plr) then return false end
            return true
        end
        -- 180 = 整个屏幕可见范围才锁；360 = 屏幕外也能锁
        local screenOnly = (angleMode == "180" or angleMode == "180°" or angleMode:lower() == "front" or angleMode:lower() == "screen")
        if cam then
            local aimP = bodyAimPos(part) or part.Position
            local sp, onScreen = cam:WorldToViewportPoint(aimP)
            local visible = onScreen and sp.Z and sp.Z > 0
            if screenOnly then
                -- 整屏：必须在屏幕里
                if not visible then return false end
                if useFOV then
                    local d = (Vector2.new(sp.X, sp.Y) - fovOrigin).Magnitude
                    if d > fov then return false end
                end
            else
                -- 360：屏外也可；仅当目标在屏上且开了 FOV 才套 FOV 圈
                if useFOV and visible then
                    local d = (Vector2.new(sp.X, sp.Y) - fovOrigin).Magnitude
                    if d > fov then return false end
                end
            end
        end
        return true
    end

    -- 指定玩家：距离内始终可锁（FOV 仍可选）
    local sel = tostring(Settings.SelectedPlayer or "")
    if sel ~= "" and sel ~= "(all)" then
        local targetPlayer = Players:FindFirstChild(sel)
        if targetPlayer and targetPlayer ~= LocalPlayer then
            local char = targetPlayer.Character
            if char and IsAlive(char) then
                local part = resolveAimPart(char)
                if part and accept(targetPlayer, part) then
                    stickyPart, stickyPlr, stickyUntil = part, targetPlayer, now + STICKY_TIME
                    currentTargetPlr = targetPlayer
                    return part
                end
            end
        end
        stickyPart, stickyPlr = nil, nil
        currentTargetPlr = nil
        return nil
    end

    -- 粘性：短时间保持同一目标，减少乱跳
    if stickyPart and stickyPart.Parent and stickyPlr and now < stickyUntil then
        if accept(stickyPlr, stickyPart) then
            currentTargetPlr = stickyPlr
            return stickyPart
        end
    end

    local closest, closestPlr = nil, nil
    local shortest = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and IsAlive(char) then
                local part = resolveAimPart(char)
                if part and accept(player, part) then
                    local aimP = bodyAimPos(part) or part.Position
                    local score
                    if soruMode then
                        score = myPos and (aimP - myPos).Magnitude or 0
                    elseif useFOV and cam then
                        local sp = cam:WorldToViewportPoint(aimP)
                        score = (Vector2.new(sp.X, sp.Y) - fovOrigin).Magnitude
                    else
                        score = myPos and (aimP - myPos).Magnitude or 0
                    end
                    if score < shortest then
                        shortest = score
                        closest = part
                        closestPlr = player
                    end
                end
            end
        end
    end
    if closest then
        -- 瞬步不做迟滞，直接最近
        if not soruMode and stickyPlr and stickyPlr ~= closestPlr and stickyPart and stickyPart.Parent then
            local oldP = bodyAimPos(stickyPart) or stickyPart.Position
            local oldScore
            if useFOV and cam then
                local sp = cam:WorldToViewportPoint(oldP)
                oldScore = (Vector2.new(sp.X, sp.Y) - fovOrigin).Magnitude
            else
                oldScore = myPos and (oldP - myPos).Magnitude or 0
            end
            local margin = useFOV and 18 or 6
            if accept(stickyPlr, stickyPart) and shortest > oldScore - margin then
                closest, closestPlr = stickyPart, stickyPlr
            end
        end
        stickyPart, stickyPlr, stickyUntil = closest, closestPlr, now + STICKY_TIME
    end
    currentTargetPlr = closestPlr
    return closest
end

-- 持续刷新目标
addConn(RunService.Heartbeat:Connect(function()
    if not running then return end
    if Settings.Enabled then
        -- 联盟状态实时：取消联盟 / 换阵营立刻更新
        if stickyPlr and isFriendly(stickyPlr) then
            stickyPart, stickyPlr, stickyUntil = nil, nil, 0
        end
        if currentTargetPlr and isFriendly(currentTargetPlr) then
            currentSilentAimTarget = nil
            currentTargetPlr = nil
        end
        -- 锁中/交战中：掉血视为被我打中 → 标记 InCombat；死亡清目标（红线不瞄尸体）
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not char or not hum or hum.Health <= 0 then
                    if CombatUntil[plr] then ClearCombat(plr) end
                    if stickyPlr == plr then stickyPart, stickyPlr, stickyUntil = nil, nil, 0 end
                    if currentTargetPlr == plr then
                        currentSilentAimTarget = nil
                        currentTargetPlr = nil
                    end
                else
                    local hp = hum.Health
                    local prev = CombatLastHP[plr]
                    if prev ~= nil and hp < prev - 0.5 then
                        -- 掉血：若近期是我的目标或距离近，记交战
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        local my = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local near = hrp and my and (hrp.Position - my.Position).Magnitude < 220
                        if near or stickyPlr == plr or currentTargetPlr == plr then
                            MarkInCombat(plr)
                        end
                    end
                    CombatLastHP[plr] = hp
                end
            end
        end
        if stickyPlr and stickyPlr.Character and not IsAlive(stickyPlr.Character) then
            stickyPart, stickyPlr, stickyUntil = nil, nil, 0
            ClearCombat(stickyPlr)
        end
        -- 自己也在 In Combat 且仍有粘目标：刷新交战（对齐 BF 互打）
        if stickyPlr and stickyPlr.Parent and IsAlive(stickyPlr.Character) then
            if GuiSaysInCombat(LocalPlayer) or AttrSaysInCombat(LocalPlayer) then
                MarkInCombat(stickyPlr)
            end
        end
        -- 瞬步按住后短时间仍按 soru 最近目标
        -- 按着 R / 刚按过 R：始终用瞬步参数（最近玩家 500 内，无视 FOV）
        local forceSoru = (_G.SoruAim == true) and (
            LastSkillPressed == "R"
            or (stickyUntil and tick() < stickyUntil)
        )
        local t = GetTarget(forceSoru and { soru = true } or nil)
        if t and t.Parent then
            currentSilentAimTarget = t
            -- currentTargetPlr 已在 GetTarget 里更新
        else
            -- 移动时短暂丢目标：粘住上一个玩家的部位，红线不闪
            local keep = false
            if currentTargetPlr and currentTargetPlr.Parent and not isFriendly(currentTargetPlr) then
                local ch = currentTargetPlr.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local part = ch and (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head"))
                if part and hum and hum.Health > 0 then
                    currentSilentAimTarget = part
                    keep = true
                end
            end
            if not keep then
                currentSilentAimTarget = nil
                -- 不立刻清 currentTargetPlr，给红线 0.2s 缓冲在 Render 里处理
            end
        end
    else
        currentSilentAimTarget = nil
        currentTargetPlr = nil
    end
end))

