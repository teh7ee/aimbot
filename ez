-- 窗口是否还活着（点 X / Close 后可能已 Destroy）
local function isWindowAlive()
    if not Window or not uiBuilt then return false end
    local alive = false
    pcall(function()
        -- 访问任意字段；已销毁会失败
        local _ = Window.SetVisible or Window.Visible or Window.Open or Window.Destroy
        alive = true
    end)
    if not alive then
        Window = nil
        uiBuilt = false
        uiVisible = false
        return false
    end
    return true
end

local function setWindowVisible(vis)
    vis = vis and true or false
    if not isWindowAlive() then
        uiVisible = false
        pcall(function() if type(syncFloatBall) == "function" then syncFloatBall() end end)
        return false
    end
    -- WindUI 官方：Open / Close / Toggle（不要只用 SetVisible）
    local ok = pcall(function()
        if vis then
            if Window.Open then
                Window:Open()
            elseif Window.SetVisible then
                Window:SetVisible(true)
            elseif type(Window.Visible) == "boolean" then
                Window.Visible = true
            end
        else
            if Window.Close then
                Window:Close()
            elseif Window.SetVisible then
                Window:SetVisible(false)
            elseif type(Window.Visible) == "boolean" then
                Window.Visible = false
            end
        end
    end)
    uiVisible = vis
    pcall(function() if type(syncFloatBall) == "function" then syncFloatBall() end end)
    pcall(function() if type(syncAuxUI) == "function" then syncAuxUI() end end)
    return ok
end

