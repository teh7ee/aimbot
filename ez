local function GetCurrentWeaponType()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    local attr = tool:GetAttribute("WeaponType")
    if attr then
        local a = tostring(attr)
        if a == "Blox Fruit" or a == "Fruit" then return "Demon Fruit" end
        return a
    end
    local tip = ""
    pcall(function()
        if tool:FindFirstChild("ToolTip") and tool.ToolTip:IsA("ValueBase") then
            tip = tostring(tool.ToolTip.Value)
        else
            tip = tostring(tool.ToolTip or "")
        end
    end)
    if tip == "Melee" then return "Melee" end
    if tip == "Blox Fruit" then return "Demon Fruit" end
    if tip == "Sword" then return "Sword" end
    if tip == "Gun" then return "Gun" end
    local n = string.lower(tool.Name)
    if n:find("guitar") or n:find("soul guitar") then return "Sword" end
    if n:find("sword") or n:find("blade") or n:find("katana") or n:find("buddy") or n:find("tushita") or n:find("yama") then return "Sword" end
    if n:find("gun") or n:find("rifle") or n:find("pistol") or n:find("acidum") then return "Gun" end
    if n:find("fruit") or n:find("portal") or n:find("dragon") or n:find("dough") then return "Demon Fruit" end
    return "Melee"
end

local function resolveAimPart(char)
    if not char then return nil end
    local pref = tostring(_G.AimPart or "HumanoidRootPart")
    local p = char:FindFirstChild(pref)
    if p and p:IsA("BasePart") then return p end
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("Head")
end

-- 躯干中心：比纯 HRP 更准（技能落点）
local function bodyAimPos(part)
    if not part or not part.Parent then return nil end
    local char = part.Parent
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    local base = part.Position
    -- 优先胸口（技能/吉他Z 落点更稳）
    if torso and head then
        base = torso.Position:Lerp(head.Position, 0.22)
    elseif hrp and torso then
        base = (hrp.Position * 0.35 + torso.Position * 0.65)
        base = Vector3.new(base.X, torso.Position.Y + 0.35, base.Z)
    elseif torso then
        base = torso.Position + Vector3.new(0, 0.4, 0)
    elseif head and hrp then
        base = head.Position:Lerp(hrp.Position, 0.45)
    elseif hrp then
        base = hrp.Position + Vector3.new(0, 1.1, 0)
    end
    return base
end

