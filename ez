local function hideGuiLine()
    if AimLineFrame then AimLineFrame.Visible = false end
    if AimDotFrame then AimDotFrame.Visible = false end
end

local function setGuiLine(fromPos, toPos)
    if not ensureAimLineGui() or not AimLineFrame then return end
    local dx = toPos.X - fromPos.X
    local dy = toPos.Y - fromPos.Y
    local len = math.sqrt(dx * dx + dy * dy)
    if len < 2 then
        hideGuiLine()
        return
    end
    local mid = Vector2.new((fromPos.X + toPos.X) * 0.5, (fromPos.Y + toPos.Y) * 0.5)
    AimLineFrame.Size = UDim2.fromOffset(math.max(len, 2), 4)
    AimLineFrame.Position = UDim2.fromOffset(mid.X, mid.Y)
    AimLineFrame.Rotation = math.deg(math.atan2(dy, dx))
    AimLineFrame.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
    AimLineFrame.BackgroundTransparency = 0
    AimLineFrame.Visible = true
    if AimLineGui then AimLineGui.Enabled = true end
    if AimDotFrame then
        AimDotFrame.Position = UDim2.fromOffset(toPos.X, toPos.Y)
        AimDotFrame.Visible = true
    end
end

