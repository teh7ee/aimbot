        setreadonly(mmt, true)
        print("[SilentAim] MouseModule OK")
    end
end)

-- 3) mouse __index（self == mouse）— 用当前 GetMouse()，重生后目标仍走 currentSilentAimTarget
local mouseHookInstalled = false
local function InstallMouseIndexHook()
    if not (hookmetamethod and newcclosure and checkcaller) then return end
    if mouseHookInstalled then return end -- game 级 hook 一次即可，self 用 GetMouse() 动态比
    mouseHookInstalled = true
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if not running then return oldIndex(self, key) end
        local mouse = LocalPlayer:GetMouse()
        if Settings.Enabled and currentSilentAimTarget and not checkcaller() and self == mouse then
            local pos = getAimPos()
            if typeof(pos) == "Vector3" then
                local cp = Workspace.CurrentCamera.CFrame.Position
                if key == "Hit" then return CFrame.new(pos)
                elseif key == "Target" then return currentSilentAimTarget
                elseif key == "UnitRay" then return Ray.new(cp, (pos - cp).Unit)
                elseif key == "Origin" then return cp
                elseif key == "Direction" then return (pos - cp).Unit
                end
            end
        end
        return oldIndex(self, key)
    end))
    print("[SilentAim] mouse __index OK")
end
pcall(InstallMouseIndexHook)

