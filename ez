local function IsSilentAimAlly(player)
    if not player or player == LocalPlayer then return false end
    local ok, allied = pcall(function()
        local main = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Main")
        local frame = main
            and main:FindFirstChild("Allies")
            and main.Allies:FindFirstChild("Container")
            and main.Allies.Container:FindFirstChild("Allies")
            and main.Allies.Container.Allies:FindFirstChild("ScrollingFrame")
            and main.Allies.Container.Allies.ScrollingFrame:FindFirstChild("Frame")
        if not frame then return false end
        return frame:FindFirstChild(player.Name) ~= nil
    end)
    return ok and allied == true
end

local function IsSilentAimEnemy(player)
    if not player or player == LocalPlayer then return false end
    -- 手动同盟（Allies GUI）始终视为友方，除非关掉队友过滤
    if _G.TeamCheck ~= false and IsSilentAimAlly(player) then return false end
    local myTeam, targetTeam = LocalPlayer.Team, player.Team
    -- 海军互锁：默认服务端不能伤害同海军；友善PVP/角斗场可互锁瞄准
    -- 开「允许海军互锁」或关「队友过滤」时，自瞄不再跳过同海军
    if myTeam and targetTeam and myTeam.Name == "Marines" and targetTeam.Name == "Marines" then
        if _G.TeamCheck == false or _G.AllowMarineVsMarine == true then
            return true
        end
        return false
    end
    return true
end

local function IsInSafeZone(plr)
    if not plr then return false end
    -- 属性优先（服务端最准）
    local function attrSafe(obj)
        if not obj then return false end
        local ok, v = pcall(function() return obj:GetAttribute("SafeZone") end)
        if ok and v == true then return true end
        ok, v = pcall(function() return obj:GetAttribute("InSafeZone") end)
        if ok and v == true then return true end
        ok, v = pcall(function() return obj:GetAttribute("PvpDisabled") end)
        if ok and v == true then return true end
        return false
    end
    if attrSafe(plr) then return true end
    local char = plr.Character
    if not char then return false end
    if attrSafe(char) then return true end
    if char:FindFirstChildOfClass("ForceField") then return true end
    -- 本地自己在安全区时，也视为目标不可锁（防止边缘误锁）
    if plr ~= LocalPlayer and attrSafe(LocalPlayer) then
        local myChar = LocalPlayer.Character
        if myChar and (attrSafe(myChar) or myChar:FindFirstChildOfClass("ForceField")) then
            -- 只有双方都在安全区才硬拦；交战例外在 accept 里处理
        end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local zones = GetSafeZones()
    if not zones then return false end
    local pos = hrp.Position
    for _, zone in ipairs(zones) do
        local r = (zone.radius or 0) + 8 -- 边缘缓冲，减少边界闪烁误锁
        if (pos - zone.pos).Magnitude <= r then
            return true
        end
    end
    return false
end

