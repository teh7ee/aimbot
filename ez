        -- 清旧粘性目标（旧 HRP 已失效）
        stickyPart, stickyPlr, stickyUntil = nil, nil, 0
        currentSilentAimTarget = nil
        currentTargetPlr = nil

        -- 速度
        if _G.SpeedEnabled and hum then
            pcall(function()
                if hum:GetAttribute("__BFSA_SpdHook") then
                    hum:SetAttribute("__BFSA_SpdHook", nil)
                end
                hookHumSpeed(hum)
                applySpeedNow()
            end)
        end

        -- 冲刺长度
        if _G.DashBoost then
            pcall(ManageDashLength)
        end

        -- ESP 文件夹可能被游戏清掉
        pcall(function()
            if not ESPFolder or not ESPFolder.Parent then
                ESPFolder = Instance.new("Folder")
                ESPFolder.Name = "BF_SilentAim_ESP"
                pcall(function() ESPFolder.Parent = CoreGui end)
                if not ESPFolder.Parent then
                    local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 3)
                    if pg then ESPFolder.Parent = pg end
                end
            end
            -- 清掉指向旧角色的 billboard
            for plr, pack in pairs(espPool) do
                pcall(function()
                    if pack and pack.gui then pack.gui:Destroy() end
                end)
                espPool[plr] = nil
            end
        end)

        -- 血拳 / 钻石 槽位重新识别
        pcall(function()
            if type(sangInitSlot) == "function" then sangInitSlot(false) end
        end)

        -- 强制刷新一次目标 + ESP
        pcall(function()
            if Settings.Enabled then
                currentSilentAimTarget = GetTarget()
            end
        end)
        pcall(function()
            if type(updateESP) == "function" then updateESP() end
        end)

        print("[SilentAim] 重生已重挂: 速度/冲刺/ESP/自瞄")
    end)
end

