local function ManageDashLength()
    if dashLoop then pcall(function() task.cancel(dashLoop) end) dashLoop = nil end
    pcall(function()
        if type(SangCFG) == "table" then SangCFG.Enabled = false end
        if type(sangConns) == "table" then
            for _, c in ipairs(sangConns) do pcall(function() c:Disconnect() end) end
        end
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, n in ipairs({"SangZ_BV", "SangZ_LV", "SangZ_Att", "SangZ_Linear"}) do
                local o = hrp:FindFirstChild(n)
                if o then o:Destroy() end
            end
        end
    end)
    if not _G.DashBoost then
        local char = LocalPlayer.Character
        if char then
            pcall(function()
                char:SetAttribute("DashLength", nil)
                char:SetAttribute("DashLengthAir", nil)
            end)
        end
        return
    end
    dashLoop = task.spawn(function()
        while running and _G.DashBoost do
            task.wait(0.15)
            local char = LocalPlayer.Character
            if char then
                local add = math.clamp(tonumber(_G.DashAdd) or 40, 0, 200)
                pcall(function()
                    char:SetAttribute("DashLength", add)
                    char:SetAttribute("DashLengthAir", add)
                end)
            end
        end
    end)
end

local function doDashBoost()
    if not _G.DashBoost then return end
    local now = tick()
    if now - lastDashAt < 0.3 then return end
    lastDashAt = now
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local cam = Workspace.CurrentCamera
    local look = cam and cam.CFrame.LookVector or hrp.CFrame.LookVector
    local dir = Vector3.new(look.X, 0, look.Z)
    if dir.Magnitude < 0.1 then dir = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z) end
    dir = dir.Unit
    local power = tonumber(_G.DashPower) or 280
    local dur = tonumber(_G.DashTime) or 0.2
    for _, v in ipairs(hrp:GetChildren()) do
        if v.Name == "BF_Dash" then pcall(function() v:Destroy() end) end
    end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "BF_Dash"
    bv.MaxForce = Vector3.new(8e4, 0, 8e4)
    bv.Velocity = dir * power
    bv.Parent = hrp
    task.delay(dur, function() if bv and bv.Parent then bv:Destroy() end end)
end

