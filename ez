if not _G.__BFSA_UIKeyHooked then
    _G.__BFSA_UIKeyHooked = true
    addConn(UIS.InputBegan:Connect(function(input, gpe)
        if not running then return end
        if UIS:GetFocusedTextBox() then return end
        if capturingUIKey then
            local name = GetBindNameFromInput(input)
            if name and name ~= "Unknown" then
                capturingUIKey = false
                Settings.UIKey = name
                _G.UIKey = name
                refreshUIKeyLabel()
                SaveConfig()
                print("[SilentAim] 面板键:", name)
                if WindUI and WindUI.Notify then
                    WindUI:Notify({ Title = "已绑定", Content = "面板键 = " .. name, Duration = 2 })
                end
            end
            return
        end
        if matchUIKey(input) then
            toggleUI()
        end
    end))
end


-- ===== 悬浮球（点一下 = 开关面板）=====
local floatGui, floatBtn
local function ensureFloatBall()
    if floatGui and floatGui.Parent then return end
    pcall(function()
        floatGui = Instance.new("ScreenGui")
        floatGui.Name = "BF_SilentAim_Float"
        floatGui.ResetOnSpawn = false
        floatGui.DisplayOrder = 99998
        floatGui.IgnoreGuiInset = true
        local parentOk = pcall(function()
            floatGui.Parent = (typeof(gethui) == "function" and gethui()) or CoreGui
        end)
        if not floatGui.Parent then
            floatGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
        end
        floatBtn = Instance.new("TextButton")
        floatBtn.Name = "Ball"
        floatBtn.Size = UDim2.fromOffset(52, 52)
        floatBtn.Position = UDim2.new(1, -70, 0.45, 0)
        floatBtn.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
        floatBtn.Text = "月"
        floatBtn.Font = Enum.Font.GothamBold
        floatBtn.TextSize = 20
        floatBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        floatBtn.AutoButtonColor = true
        floatBtn.Parent = floatGui
        Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 180, 190)
        stroke.Thickness = 1.5
        stroke.Parent = floatBtn
        -- 点击 = 开关 UI（官方 Open/Close/Toggle）
        floatBtn.MouseButton1Click:Connect(function()
            if type(toggleUI) == "function" then
                toggleUI()
            end
        end)
        -- 拖动：按住移动
        local dragging, start, startPos
        floatBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                start = input.Position
                startPos = floatBtn.Position
            end
        end)
        addConn(UIS.InputChanged:Connect(function(input)
            if not dragging or not start then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - start
                if d.Magnitude > 10 then
                    floatBtn.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + d.X,
                        startPos.Y.Scale, startPos.Y.Offset + d.Y
                    )
                end
            end
        end))
        addConn(UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
        pcall(syncFloatBall)
    end)
end
ensureFloatBall()
-- 状态同步：月=可开面板，关=点一下收起
task.defer(function()
    task.wait(0.5)
    pcall(syncFloatBall)
end)

