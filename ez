-- 种族 V3：BF 用 RaceEnergy(0~1 充能) + RaceTransformed(是否开启)
-- 能量满 ≈ 可放；变身中 = Active；充能中按约 30s 总 CD 估剩余
local function getRaceV3CD(plr)
    local text = "V3: ?"
    pcall(function()
        local char = plr.Character
        if not char then
            text = "V3: —"
            return
        end
        -- 变身 / 技能进行中
        local transformed = false
        local rt = char:FindFirstChild("RaceTransformed")
        if rt then
            if rt:IsA("BoolValue") then transformed = rt.Value == true
            elseif rt:IsA("ValueBase") then transformed = tostring(rt.Value) == "true" or rt.Value == true
            else transformed = true end
        end
        if char:GetAttribute("RaceTransformed") == true then transformed = true end
        if transformed then
            text = "V3: Active"
            return
        end

        -- RaceEnergy：NumberValue 0~1（常见）
        local energy = nil
        local re = char:FindFirstChild("RaceEnergy")
        if re and re:IsA("ValueBase") then
            energy = tonumber(re.Value)
        end
        if energy == nil then
            energy = tonumber(char:GetAttribute("RaceEnergy"))
        end

        if typeof(energy) == "number" then
            if energy >= 0.98 then
                text = "V3: Ready"
            elseif energy <= 0.02 then
                -- 刚放完，按 30s 满 CD 估
                text = "V3: ~30s"
            else
                local left = (1 - energy) * 30
                if left < 0.5 then
                    text = "V3: Ready"
                else
                    text = string.format("V3: ~%.0fs", left)
                end
            end
            return
        end

        -- 兜底：属性倒计时
        local cd = char:GetAttribute("RaceAbilityCD")
            or char:GetAttribute("V3CD")
            or char:GetAttribute("RaceCD")
            or char:GetAttribute("AbilityCD")
            or char:GetAttribute("RaceSkillCD")
            or char:GetAttribute("RaceV3CD")
        local data = plr:FindFirstChild("Data")
        if cd == nil and data then
            local n = data:FindFirstChild("RaceAbilityCD") or data:FindFirstChild("V3CD") or data:FindFirstChild("RaceCD")
            if n and n:IsA("ValueBase") then cd = n.Value end
        end
        if typeof(cd) == "number" then
            if cd > 1e9 then
                local left = cd - workspace:GetServerTimeNow()
                if left ~= left then left = cd - os.clock() end -- nan guard
                if left > 0 and left < 600 then
                    text = string.format("V3: %.0fs", left)
                else
                    text = "V3: Ready"
                end
            elseif cd > 0 and cd <= 120 then
                text = string.format("V3: %.0fs", cd)
            else
                text = "V3: Ready"
            end
        else
            text = "V3: Ready"
        end
    end)
    return text
end

local function formatBounty(n)
    n = tonumber(n) or 0
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
    return tostring(math.floor(n))
end

local function getLevel(plr)
    local lv = nil
    pcall(function()
        local data = plr:FindFirstChild("Data")
        if data then
            for _, name in ipairs({ "Level", "Lvl", "PlayerLevel" }) do
                local v = data:FindFirstChild(name)
                if v and v:IsA("ValueBase") then
                    lv = tonumber(v.Value)
                    if lv then break end
                end
            end
        end
        if not lv then
            local ls = plr:FindFirstChild("leaderstats")
            if ls then
                local v = ls:FindFirstChild("Level") or ls:FindFirstChild("Lvl")
                if v and v:IsA("ValueBase") then lv = tonumber(v.Value) end
            end
        end
        if not lv then
            local a = plr:GetAttribute("Level") or plr:GetAttribute("Lvl")
            if a ~= nil then lv = tonumber(a) end
        end
    end)
    return lv
end

local function getBountyOrHonor(plr)
    local val, kind = nil, "Bounty"
    pcall(function()
        local data = plr:FindFirstChild("Data")
        if data then
            local b = data:FindFirstChild("Bounty")
            local h = data:FindFirstChild("Honor") or data:FindFirstChild("Honors")
            if b and b:IsA("ValueBase") and tonumber(b.Value) then
                val, kind = tonumber(b.Value), "Bounty"
            end
            if h and h:IsA("ValueBase") and tonumber(h.Value) then
                if (plr.Team and plr.Team.Name == "Marines") or not val then
                    val, kind = tonumber(h.Value), "Honor"
                end
            end
        end
        if not val then
            local ls = plr:FindFirstChild("leaderstats")
            if ls then
                for _, name in ipairs({ "Bounty", "Honor" }) do
                    local v = ls:FindFirstChild(name)
                    if v and v:IsA("ValueBase") and tonumber(v.Value) then
                        val = tonumber(v.Value)
                        kind = name
                        break
                    end
                end
            end
        end
        if not val then
            local a = plr:GetAttribute("Bounty") or plr:GetAttribute("Honor")
            if a ~= nil then val = tonumber(a) end
        end
    end)
    return val, kind
end

