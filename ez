local function findWindMainFrame()
    -- WindUI 主容器（优先官方字段）
    if Window then
        local ok, main = pcall(function()
            if Window.UIElements and Window.UIElements.Main then return Window.UIElements.Main end
            if Window.Root then return Window.Root end
            if Window.Background then return Window.Background end
            return nil
        end)
        if ok and main and typeof(main) == "Instance" then return main end
    end
    local best, bestArea = nil, 0
    local function scan(root)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("Frame") or d:IsA("CanvasGroup") then
                local ax, ay = d.AbsoluteSize.X, d.AbsoluteSize.Y
                if ax > 320 and ay > 220 then
                    local area = ax * ay
                    local n = string.lower(tostring(d.Name))
                    -- 优先名字像窗口主体的
                    if n:find("main") or n:find("window") or n:find("frame") or area > bestArea then
                        if area >= bestArea then
                            bestArea = area
                            best = d
                        end
                    end
                end
            end
        end
    end
    pcall(function()
        for _, g in ipairs(CoreGui:GetChildren()) do
            local n = tostring(g.Name)
            if n:find("Wind") or n:find("SilentAim") or n:find("BF_") or n:find("DropShadow") then
                scan(g)
            end
        end
    end)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, g in ipairs(pg:GetChildren()) do
                local n = tostring(g.Name)
                if n:find("Wind") or n:find("SilentAim") then scan(g) end
            end
        end
    end)
    return best
end

local function attachSelfAvatar()
    -- 保证已创建
    if type(ensureAvatarHud) == "function" then
        pcall(ensureAvatarHud)
    end
    if not avatarGui or not avatarGui.Parent then return end
    local box = avatarGui:FindFirstChild("SelfAvatar", true)
    if not box then return end
    if box.Parent ~= avatarGui then box.Parent = avatarGui end

    if not uiVisible then
        box.Visible = false
        avatarGui.Enabled = false
        return
    end

    avatarGui.Enabled = true
    box.Visible = true
    box.Size = UDim2.fromOffset(210, 68)
    box.AnchorPoint = Vector2.new(0, 1)

    local placed = false
    pcall(function()
        local main = findWindMainFrame and findWindMainFrame()
        if main then
            local ap, asz = main.AbsolutePosition, main.AbsoluteSize
            if asz.X > 100 and asz.Y > 100 then
                box.Position = UDim2.fromOffset(ap.X + 14, ap.Y + asz.Y - 12)
                placed = true
            end
        end
    end)
    if not placed then
        -- 固定：屏幕水平居中偏左、垂直中下（对齐默认 WindUI 窗）
        local cam = Workspace.CurrentCamera
        local v = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        box.Position = UDim2.fromOffset(math.floor(v.X * 0.5 - 290), math.floor(v.Y * 0.5 + 210))
    end
end

local function syncAuxUI()
    pcall(syncFloatBall)
    pcall(function()
        if type(attachSelfAvatar) == "function" then attachSelfAvatar() end
    end)
end

local function syncFloatBall()
    pcall(function()
        if not floatBtn then return end
        if uiVisible and isWindowAlive() then
            floatBtn.BackgroundColor3 = Color3.fromRGB(65, 200, 90)
            floatBtn.Text = "关"
        else
            floatBtn.BackgroundColor3 = Color3.fromRGB(255, 45, 70)
            floatBtn.Text = "月"
            uiVisible = false
        end
    end)
end

local function toggleUI()
    local now = tick()
    if now - (lastUIToggle or 0) < 0.15 then return end
    lastUIToggle = now
    if uiBuilding then return end

    local alive = isWindowAlive() == true

    if alive then
        -- 优先官方 Toggle；再按状态 Open/Close
        local used = false
        pcall(function()
            if Window.Toggle then
                Window:Toggle()
                uiVisible = not uiVisible
                used = true
            end
        end)
        if not used then
            if uiVisible then
                setWindowVisible(false)
            else
                setWindowVisible(true)
            end
        end
        -- 以我们跟踪的状态为准刷新月按钮
        syncFloatBall()
        pcall(function() if type(syncAuxUI) == "function" then syncAuxUI() end end)
        return
    end

    -- 没窗口：建一个并打开
    uiBuilt = false
    Window = nil
    local ok, err = pcall(buildUI)
    if not ok then
        warn("[SilentAim] UI 打开失败:", err)
        uiVisible = false
    else
        uiVisible = true
        pcall(function()
            if Window and Window.Open then Window:Open() end
        end)
    end
    syncFloatBall()
    pcall(function() if type(syncAuxUI) == "function" then syncAuxUI() end end)
end

