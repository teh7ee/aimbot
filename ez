    if not running then return end
    task.spawn(function()
        -- 等角色部件就绪
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 8)
        task.wait(0.35)
