local function FacePartTowards(targetPart)
    if _G.FaceTargetOnSkill == false then return end
    if not targetPart or not targetPart.Parent then return end
    -- 窗口外绝不拧
    if tick() >= (faceUntil or 0) then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if hum.SeatPart or char:FindFirstChildOfClass("Seat") then return end
    local aim = targetPart.Position
    pcall(function()
        local bp = bodyAimPos(targetPart)
        if bp then aim = bp end
    end)
    local pos = hrp.Position
    -- 只水平朝向，禁止 pitch，避免技能后上下疯转
    local flat = Vector3.new(aim.X - pos.X, 0, aim.Z - pos.Z)
    if flat.Magnitude < 0.35 then return end
    local look = flat.Unit
    local cf = CFrame.new(pos, pos + look)
    -- 保留当前 Y 轴旋转平滑感：直接对齐水平朝向
    hrp.CFrame = CFrame.new(pos) * (cf - cf.Position)
end


