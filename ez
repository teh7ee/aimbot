    if weaponType == "Melee" then
        keyMap = _G.BF_Aimbot_MeleeKeys
    elseif weaponType == "Demon Fruit" then
        keyMap = _G.BF_Aimbot_FruitKeys
    elseif weaponType == "Sword" then
        keyMap = _G.BF_Aimbot_SwordKeys
    elseif weaponType == "Gun" then
        keyMap = _G.BF_Aimbot_GunKeys
    end
    if key == "M1" then
        SkillEnabled = (_G.M1Aim ~= false)
    elseif key == "R" then
        -- 瞬步自瞄：只锁玩家（不锁地面）；距离不够不粘目标
        SkillEnabled = (_G.SoruAim == true)
        if SkillEnabled and Settings.Enabled then
            stickyPart, stickyPlr, stickyUntil = nil, nil, 0
            local part = GetTarget({ soru = true })
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if part and part.Parent and myRoot then
                local dist = (myRoot.Position - part.Position).Magnitude
                -- 距离够 → 粘住目标（瞬到人身上方向）；瞄地/太远不粘
                if dist >= 8 and dist <= 500 then
                    currentSilentAimTarget = part
                    stickyPart = part
                    stickyPlr = currentTargetPlr
                    stickyUntil = tick() + 0.65
                else
                    -- 太近/太远：不锁地，不瞬偏
                    currentSilentAimTarget = nil
                    currentTargetPlr = nil
                end
            end
        end
    elseif keyMap then
        SkillEnabled = keyMap[key] == true
    else
        SkillEnabled = false
    end
    -- 放技能时朝向当前/即将锁定的目标（保持一小段时间盖住前摇）
    if SkillEnabled and key ~= nil then
        faceUntil = tick() + 0.28
        task.defer(function()
            local part = currentSilentAimTarget
            if not part or not part.Parent then
                pcall(function()
                    part = GetTarget()
                end)
            end
            if part then
                FacePartTowards(part)
                local plr = currentTargetPlr
                if not plr and part.Parent then
                    plr = Players:GetPlayerFromCharacter(part.Parent)
                end
                if plr then MarkInCombat(plr) end
            end
        end)
    end
end))

