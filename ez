-- PvP 关闭判定：属性多路径 + 角色，宁可多拦不误锁
local function IsPvpDisabled(plr)
    if not plr then return false end
    local names = { "PvpDisabled", "PVPDisabled", "PvpOff", "PVPOff", "NoPVP", "SafeZone", "InSafeZone" }
    local function check(obj)
        if not obj then return false end
        for _, n in ipairs(names) do
            local ok, v = pcall(function() return obj:GetAttribute(n) end)
            if ok and (v == true or v == 1 or v == "true") then
                -- SafeZone/InSafeZone 不算「关PvP」本身，下面只对 Pvp* 当硬关
                if n == "SafeZone" or n == "InSafeZone" then
                    -- 留给安全区逻辑
                else
                    return true
                end
            end
        end
        local ch = obj:FindFirstChild("PvpDisabled") or obj:FindFirstChild("PVPDisabled")
        if ch then
            if ch:IsA("BoolValue") and ch.Value == true then return true end
            if ch:IsA("NumberValue") and ch.Value ~= 0 then return true end
        end
        return false
    end
    if check(plr) then return true end
    local char = plr.Character
    if char then
        if check(char) then return true end
        -- ForceField 在 BF 常与安全区/无敌绑在一起；ExcludePVP 开启时也跳过
        if char:FindFirstChildOfClass("ForceField") then
            return true
        end
    end
    return false
end

