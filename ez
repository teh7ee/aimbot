    UseCFrameNudge = _G.SangZUseCFrame ~= false,
    CFrameSpeed = tonumber(_G.SangZCFrameSpeed) or 140,
    FollowCamera = false,
    PowerMin = 100,
    PowerMax = 3000,
}
local sangSlot1, sangSlotLocked = nil, false
local sangBoosting, sangLastBoost = false, 0
local sangZHeld, sangPending = false, false
sangConns = {}

local function sangEquipped()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Tool")
end
sangInitSlot = function(force)
    if sangSlotLocked and not force then return sangSlot1 end
    local eq = sangEquipped()
    if eq then sangSlot1, sangSlotLocked = eq.Name, true return sangSlot1 end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") then sangSlot1, sangSlotLocked = c.Name, true return sangSlot1 end
        end
    end
    return sangSlot1
end
local function sangIsSlot1()
    local eq = sangEquipped()
    if not eq then return false end
    if not sangSlot1 then sangInitSlot(true) end
    return eq.Name == sangSlot1
end
local function sangLook()
    local cam = Workspace.CurrentCamera
    if cam then return cam.CFrame.LookVector end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.CFrame.LookVector end
    return Vector3.new(0, 0, -1)
end
local function sangClear(hrp)
    for _, n in ipairs({"SangZ_BV", "SangZ_LV", "SangZ_Att", "SangZ_Linear"}) do
        local o = hrp:FindFirstChild(n)
        if o then pcall(function() o:Destroy() end) end
    end
end
local function sangDoBoost(reason, dir)
    if not SangCFG.Enabled or not running then return end
    local now = os.clock()
    if now - sangLastBoost < 0.28 or sangBoosting then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end
    dir = dir or sangLook()
    if typeof(dir) ~= "Vector3" or dir.Magnitude < 1e-4 then dir = Vector3.new(0, 0, -1) else dir = dir.Unit end
    local boostDir = dir
    sangLastBoost = now
    sangBoosting = true
    local power = math.clamp(SangCFG.Power, SangCFG.PowerMin, SangCFG.PowerMax)
    local dur = math.clamp(SangCFG.Duration, 0.2, 2.5)
    local yb = SangCFG.YBoost or 40
    print("[SangZ]", reason, "p=", power)
    sangClear(hrp)
    if SangCFG.UseCFrameNudge then
        pcall(function() hrp.CFrame = hrp.CFrame + boostDir * 14 end)
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = boostDir * power + Vector3.new(0, yb * 0.2, 0)
    end)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "SangZ_BV"
    bv.MaxForce = Vector3.new(9e5, 9e5, 9e5)
    bv.P = 2e4
    bv.Velocity = boostDir * power + Vector3.new(0, yb * 0.2, 0)
    bv.Parent = hrp
    local att = Instance.new("Attachment")
    att.Name = "SangZ_Att"
    att.Parent = hrp
    local lv = Instance.new("LinearVelocity")
    lv.Name = "SangZ_Linear"
    lv.Attachment0 = att
    lv.MaxForce = 4e6
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VectorVelocity = boostDir * power + Vector3.new(0, yb * 0.2, 0)
    lv.Parent = hrp
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end) end
    local t0 = os.clock()
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not running or not hrp.Parent or os.clock() - t0 > dur then
            if conn then conn:Disconnect() end
            return
        end
        local d = boostDir
        if SangCFG.FollowCamera then
            local look = sangLook()
            if look.Magnitude > 1e-4 then d = look.Unit end
        end
        local vel = d * power + Vector3.new(0, yb * 0.15, 0)
        pcall(function()
            bv.Velocity = vel
            lv.VectorVelocity = vel
            hrp.AssemblyLinearVelocity = vel
        end)
        if SangCFG.UseCFrameNudge then
            local step = math.clamp(dt, 0, 0.05) * (SangCFG.CFrameSpeed or 120)
            pcall(function() hrp.CFrame = hrp.CFrame + d * step end)
        end
    end)
    table.insert(sangConns, conn)
    task.delay(dur, function()
        if conn then pcall(function() conn:Disconnect() end) end
        if hrp then sangClear(hrp) end
        sangBoosting = false
    end)
end
local function sangQueue(source)
    if not SangCFG.Enabled or not running then return end
    if not sangIsSlot1() then return end
    if sangPending then return end
    sangPending = true
    local look = sangLook()
    local delay = math.clamp(SangCFG.DelayAfterRelease or 0.22, 0, 1.5)
    task.delay(delay, function()
        sangPending = false
        if not SangCFG.Enabled or not sangIsSlot1() then return end
        local look2 = sangLook()
        sangDoBoost(source, look2.Magnitude > 0 and look2 or look)
    end)
end
