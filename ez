-- Blox Fruits In Combat（机制对齐 wiki）：
-- 被打/互打后底部出现 "In Combat"；进安全区仍可被击杀（双方不都无敌）。
-- 检测：1) 对方 PlayerGui 战斗提示 2) 常见 Attribute 3) 掉血+曾是我的目标（兜底）
local CombatUntil = {} -- [Player] = expire tick（本地交战表）
local CombatLastHP = {} -- [Player] = last HP
local function CombatSec()
    -- BF 战斗提示可持续约数十秒～1 分钟量级；默认 45s，每次命中刷新
    return math.clamp(tonumber(_G.CombatAimSec) or 45, 8, 90)
end

local function GuiSaysInCombat(plr)
    if not plr then return false end
    local ok, hit = pcall(function()
        local pg = plr:FindFirstChild("PlayerGui")
        if not pg then return false end
        -- 只扫浅层+Main，避免全树卡顿
        local roots = { pg }
        local main = pg:FindFirstChild("Main")
        if main then roots[#roots + 1] = main end
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    local s = string.lower(tostring(d.Text or ""))
                    if s:find("in combat", 1, true) or s:find("bounty/honor at risk", 1, true)
                        or s:find("at risk", 1, true) then
                        if d.Visible ~= false then
                            local p = d
                            while p and p ~= root do
                                if p:IsA("GuiObject") and p.Visible == false then break end
                                p = p.Parent
                            end
                            if p == root or (p and p.Visible ~= false) then
                                return true
                            end
                        end
                    end
                end
            end
        end
        return false
    end)
    return ok and hit == true
end

local function AttrSaysInCombat(plr)
    if not plr then return false end
    local names = {
        "InCombat", "inCombat", "Combat", "CombatTag", "Busy",
        "IsInCombat", "PVPCombat", "InPVP", "Fighting",
    }
    local function check(obj)
        if not obj then return false end
        for _, n in ipairs(names) do
            local ok, v = pcall(function() return obj:GetAttribute(n) end)
            if ok and (v == true or v == 1 or v == "true") then return true end
            local ch = obj:FindFirstChild(n)
            if ch and ch:IsA("BoolValue") and ch.Value == true then return true end
            if ch and ch:IsA("NumberValue") and ch.Value > 0 then return true end
        end
        return false
    end
    if check(plr) then return true end
    if plr.Character and check(plr.Character) then return true end
    return false
end

local function MarkInCombat(plr, sec)
    if not plr or plr == LocalPlayer then return end
    local untilT = tick() + (tonumber(sec) or CombatSec())
    if (CombatUntil[plr] or 0) < untilT then
        CombatUntil[plr] = untilT
    end
end

-- 是否处于可继续追击状态（安全区例外用）
local function IsInCombatWithMe(plr)
    if not plr or plr == LocalPlayer then return false end
    if (CombatUntil[plr] or 0) > tick() then return true end
    -- 游戏真实 In Combat 状态（UI/属性）—— 对方被打进安全区仍可杀
    if GuiSaysInCombat(plr) then
        MarkInCombat(plr, CombatSec())
        return true
    end
    if AttrSaysInCombat(plr) then
        MarkInCombat(plr, CombatSec())
        return true
    end
    return false
end

local function ClearCombat(plr)
    if plr then
        CombatUntil[plr] = nil
        CombatLastHP[plr] = nil
    end
end
