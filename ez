local function getAimPos()
    -- 自瞄：总开关 + 有目标。技能页勾选仅在“刚按下该键”时过滤
    if not Settings.Enabled then return nil end
    local part = currentSilentAimTarget
    if (not part or not part.Parent) and stickyPart and stickyPart.Parent and tick() < (stickyUntil or 0) then
        part = stickyPart
    end
    if not part or not part.Parent then return nil end
    local key = LastSkillPressed
    if key == "M1" and _G.M1Aim == false then return nil end
    if key == "R" and _G.SoruAim ~= true then return nil end
    local weaponType = GetCurrentWeaponType()
    if key and key ~= "M1" and key ~= "R" then
        local keyMap = nil
        if weaponType == "Melee" then keyMap = _G.BF_Aimbot_MeleeKeys
        elseif weaponType == "Demon Fruit" then keyMap = _G.BF_Aimbot_FruitKeys
        elseif weaponType == "Sword" then keyMap = _G.BF_Aimbot_SwordKeys
        elseif weaponType == "Gun" then keyMap = _G.BF_Aimbot_GunKeys
        end
        if keyMap and keyMap[key] == false then return nil end
    end
    local pos = bodyAimPos(part) or part.Position
    -- 吉他 / 刀类 Z：略抬高落点，减少脚下空
    local toolName = ""
    pcall(function()
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then toolName = string.lower(tostring(tool.Name or "")) end
    end)
    local isGuitar = toolName:find("guitar", 1, true) or toolName:find("soul", 1, true)
    if isGuitar or (weaponType == "Sword" and key == "Z") then
        pos = pos + Vector3.new(0, 0.85, 0)
    end
    -- 预判：基础 + 用户 Prediction；移动快时多补
    local vel = Vector3.zero
    pcall(function()
        vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    end)
    local baseLead = 0.10
    if isGuitar or key == "Z" or key == "X" then
        baseLead = 0.14
    end
    if weaponType == "Gun" then
        baseLead = 0.16
    end
    local lead = math.clamp((tonumber(_G.Prediction) or 0) + baseLead, 0, 0.55)
    local hvel = Vector3.new(vel.X, 0, vel.Z)
    local spd = hvel.Magnitude
    if spd > 1.5 then
        -- 高速多补一点
        local extra = math.clamp((spd - 20) / 120, 0, 0.12)
        pos = pos + hvel * (lead + extra)
    end
    if math.abs(vel.Y) > 6 then
        pos = pos + Vector3.new(0, vel.Y * lead * 0.62, 0)
    end
    return pos
end

